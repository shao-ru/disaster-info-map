# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 個人用の資料（共有しない）
doc(cn)/

# データ：static（アプリ用・処理済み）だけを Git に入れる
